{
  "description": "ocu-agent: send ocu turn-ended when ocu-operator stops.",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "ocu-agent:ocu-operator",
        "hooks": [
          {
            "type": "command",
            "command": "open-computer-use turn-ended >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
